# neatpad-syntax-v1
#
#   Log files: levels, dates and times, numbers and quoted text
#
language Log
files    *.log

list errors    ERROR FATAL CRITICAL SEVERE PANIC
list warnings  WARN WARNING
list info      INFO NOTICE
list debug     DEBUG TRACE VERBOSE

context main
    word in errors     error
    word in warnings   warning
    word in info       info
    word in debug      debug
    timestamp          debug
    number             number
    '"'                string   enter string

context string  string  end-of-line
    escape             escape
    '"'                string   leave
