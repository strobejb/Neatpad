<?xml version="1.0" encoding="UTF-8"?>
<!-- Compiled into the app. GtkApplication adds icons/ under its resource
     path, /net/catch22/Neatpad, to the icon theme, and AdwApplication (1.8 on)
     shows shortcuts-dialog.ui there as Keyboard Shortcuts. -->
<gresources>
  <gresource prefix="/net/catch22/Neatpad">
    <file>shortcuts-dialog.ui</file>
  </gresource>
  <!-- The syntax definitions, from src/TextView/syntax -->
  <gresource prefix="/net/catch22/Neatpad/syntax">
    <file>c.syntax</file>
    <file>log.syntax</file>
    <file>markdown.syntax</file>
  </gresource>
  <gresource prefix="/net/catch22/Neatpad/icons/scalable/actions">
    <file alias="neatpad-highlight-symbolic.svg">icons/neatpad-highlight-symbolic.svg</file>
    <file alias="neatpad-filter-symbolic.svg">icons/neatpad-filter-symbolic.svg</file>
  </gresource>
</gresources>
