# LF everywhere, as the repo stores it; CRLF only for Windows-only files,
# which Visual Studio writes that way
* text=auto eol=lf

*.rc text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.dsp text eol=crlf
*.dsw text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
/tests/samples/*.[tT][xX][tT] binary

*.bmp binary
*.cur binary
*.exe binary
*.ico binary
*.lib binary
*.png binary
*.zip binary
